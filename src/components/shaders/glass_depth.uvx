// uvx shader — glass depth blur for Argon frontend
// Compiles to a full-screen quad background blur pass

#define DEPTH_LAYERS 3

uniform sampler2D u_screen;
uniform vec2 u_resolution;
uniform float u_time;
uniform float u_depth; // 0..1 depth intensity

vec4 glassBlur(vec2 uv, float depth) {
    vec2 dir = vec2(cos(u_time * 0.5), sin(u_time * 0.3));
    vec4 color = vec4(0.0);
    float total = 0.0;
    for (int i = 0; i < 12; i++) {
        float offset = float(i) * 0.008 * depth;
        color += texture(u_screen, uv + dir * offset);
        color += texture(u_screen, uv - dir * offset);
        total += 2.0;
    }
    return color / total;
}

void main() {
    vec2 uv = gl_FragCoord.xy / u_resolution;
    vec4 screen = texture(u_screen, uv);
    vec4 blur = glassBlur(uv, u_depth);
    
    // Depth-tinted glass
    vec3 tint = mix(vec3(0.95, 1.0, 0.98), vec3(0.92, 0.96, 1.0), u_depth);
    vec4 glass = mix(screen, blur, u_depth * 0.4);
    glass.rgb *= tint;
    glass.a = 0.65 + (u_depth * 0.15);
    
    gl_FragColor = glass;
}
