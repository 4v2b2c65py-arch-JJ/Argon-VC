// uvx shader — neural pulse for chat interface background
// Animated gradient mesh that responds to audio/chat activity

uniform sampler2D u_screen;
uniform vec2 u_resolution;
uniform float u_time;
uniform float u_activity; // 0..1 chat/voice activity level

void main() {
    vec2 uv = gl_FragCoord.xy / u_resolution;
    
    // Moving gradient centers
    vec2 c1 = vec2(0.3 + 0.4 * sin(u_time * 0.5), 0.4 + 0.3 * cos(u_time * 0.3));
    vec2 c2 = vec2(0.7 - 0.3 * sin(u_time * 0.4), 0.6 + 0.2 * sin(u_time * 0.6));
    
    float d1 = length(uv - c1);
    float d2 = length(uv - c2);
    
    vec3 col1 = vec3(0.1, 0.4, 0.9);   // blue
    vec3 col2 = vec3(0.9, 0.2, 0.6);   // pink
    vec3 col3 = vec3(0.2, 0.8, 0.5);   // emerald (activity)
    
    float activityGlow = u_activity * 0.3;
    
    vec3 color = mix(col1, col2, 0.5 + 0.3 * sin(u_time));
    color += col3 * activityGlow * exp(-d2 * 3.0);
    color += vec3(0.05) * exp(-d1 * 2.0);
    
    // Combine with screen
    vec4 screen = texture(u_screen, uv);
    vec4 outColor = vec4(color * 0.4 + screen.rgb * 0.6, screen.a);
    
    gl_FragColor = outColor;
}
