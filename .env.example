# Argon Backend Environment Variables
# Copy this to .env and fill in your values. Never commit .env.

# Google OAuth2 (required for sign-in)
ARGON_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
ARGON_GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET

# OAuth2 redirect URI (must match Google Cloud Console)
ARGON_AUTH_REDIRECT_URI=http://127.0.0.1:8765/auth/google/callback

# Backend URL (frontend connects here)
ARGON_BACKEND_URL=http://127.0.0.1:8765

# CORS origins (comma-separated)
ARGON_CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8080,http://localhost:8080,https://arvc-indol.vercel.app

# Frontend directory served by the backend
ARGON_FRONTEND_DIR=F:/GPT/argon/argon-frontend-deploy
